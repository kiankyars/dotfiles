{
    "window.autoDetectColorScheme": true,
    "editor.accessibilitySupport": "off",
    "window.commandCenter": 1,
    "files.autoSave": "afterDelay",
    "python.defaultInterpreterPath": "/opt/homebrew/bin/python3",
    "editor.largeFileOptimizations": false,
    "workbench.preferredLightColorTheme": "Quiet Light",
    "workbench.preferredHighContrastColorTheme": "Abyss",
    "workbench.preferredHighContrastLightColorTheme": "Visual Studio Light",
    "editor.wordWrap": "on",
    "cursor.general.globalCursorIgnoreList": [
        "**/credentials.json",
        "**/credentials.*.json",
        "**/secret.json",
        "**/secrets.json",
        "**/*.key",
        "**/*.pem",
        "**/*.pfx",
        "**/*.p12",
        "**/*.crt",
        "**/*.cer",
        "**/id_rsa",
        "**/id_dsa",
        "**/.ssh/id_*"
    ],
    "cursor.composer.shouldChimeAfterChatFinishes": true,
    "debug.console.acceptSuggestionOnEnter": "on",
    "explorer.confirmDragAndDrop": false,
    "cursor.composer.shouldAllowCustomModes": true,
    "terminal.integrated.enableMultiLinePasteWarning": "never",
    "terminal.integrated.enableKittyKeyboardProtocol": false,
    "haskell.manageHLS": "GHCup",
    "git.openRepositoryInParentFolders": "never",
    "specstory.derivedRules.enabled": false,
    "specstory.cloudSync.enabled": "always",
    "git.confirmSync": false,
    "latex-workshop.latex.autoClean.run": "onBuilt",
    "workbench.editorAssociations": {
        "*.pdf": "latex-workshop-pdf-hook"
    },
    "latex-workshop.latex.autoBuild.run": "never",
    "explorer.confirmDelete": false,
    "workbench.editor.enablePreview": false,
    "workbench.sideBar.location": "right",
    "workbench.settings.applyToAllProfiles": [
        "workbench.sideBar.location"
    ],
    "editor.tabSize": 4,
    "editor.indentSize": "tabSize",
    "editor.detectIndentation": false,
    "editor.insertSpaces": true,
    "diffEditor.hideUnchangedRegions.enabled": true
}
